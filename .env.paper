# Paper Trading模式 - 仅需数据获取API，不需要交易API
# OKX API - 使用公开行情接口
OKX_API_KEY=none
OKX_SECRET=none
OKX_PASSWORD=none

# 链上数据API（可选）
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=

# Telegram通知（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 数据库配置
DATABASE_PATH=data/paper_trading.db

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# 策略参数配置
MA_PERIOD=20
ATR_PERIOD=14
ATR_MA_PERIOD=30
NETFLOW_MA_DAYS=7
STABLE_CHANGE_DAYS=7
STOP_ATR_MULTIPLIER=2.0
POSITION_RATIO=0.5
MAX_LOSS_PER_TRADE=0.05
MAX_DRAWDOWN_GLOBAL=0.20
FEAR_GREED_CEILING=80

DATA_FRESHNESS_THRESHOLD=3
DATA_QUALITY_FULL_THRESHOLD=1
DATA_QUALITY_DOWNGRADE_THRESHOLD=2

LIMIT_ORDER_TIMEOUT=300
MAX_ORDER_TIMEOUT=1800

RECOVERY_STAGE1_DAYS=10
RECOVERY_STAGE2_DAYS=20
