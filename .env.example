# OKX交易所API配置
OKX_API_KEY=your_api_key_here
OKX_SECRET=your_secret_key_here
OKX_PASSWORD=your_password_here

# 链上数据API配置
GLASSNODE_API_KEY=your_glassnode_key_here
CRYPTOQUANT_API_KEY=your_cryptoquant_key_here

# Telegram通知配置
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 数据库配置
DATABASE_PATH=data/aosft.db

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# 策略参数配置
MA_PERIOD=20
ATR_PERIOD=14
ATR_MA_PERIOD=30
NETFLOW_MA_DAYS=7
STABLE_CHANGE_DAYS=7
STOP_ATR_MULTIPLIER=2.0
POSITION_RATIO=0.5
MAX_LOSS_PER_TRADE=0.05
MAX_DRAWDOWN_GLOBAL=0.20
FEAR_GREED_CEILING=80

# 数据新鲜度配置
DATA_FRESHNESS_THRESHOLD=3
DATA_QUALITY_FULL_THRESHOLD=1
DATA_QUALITY_DOWNGRADE_THRESHOLD=2

# 订单超时配置
LIMIT_ORDER_TIMEOUT=300
MAX_ORDER_TIMEOUT=1800

# 熔断恢复配置
RECOVERY_STAGE1_DAYS=10
RECOVERY_STAGE2_DAYS=20
